<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MinimalPlugin</AssemblyName>
    <RootNamespace>MinimalPlugin</RootNamespace>
    <TargetExt>.rhp</TargetExt>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AssemblyTitle>MinimalPlugin</AssemblyTitle>
    <AssemblyDescription>Minimal Rhino plugin using RhinoCli.Server.</AssemblyDescription>
    <AssemblyVersion>0.1.0</AssemblyVersion>
    <FileVersion>0.1.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../server/RhinoCli.Server/RhinoCli.Server.csproj" />
    <Reference Include="RhinoCommon">
      <HintPath>/Applications/Rhino 8.app/Contents/Frameworks/RhCore.framework/Versions/A/Resources/RhinoCommon.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <MyDestinationFolder>$(APPDATA)\McNeel\Rhinoceros\myplugins\MinimalPlugin</MyDestinationFolder>
  </PropertyGroup>

  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <MyDestinationFolder>$(HOME)/Library/Application Support/McNeel/Rhinoceros/8.0/MacPlugins/MinimalPlugin</MyDestinationFolder>
  </PropertyGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <ItemGroup>
      <PluginFiles Include="$(TargetDir)*.*" />
    </ItemGroup>
    <MakeDir Directories="$(MyDestinationFolder)" />
    <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(MyDestinationFolder)" />
    <Message Text="MinimalPlugin installed to $(MyDestinationFolder)" Importance="high" />
  </Target>
</Project>
