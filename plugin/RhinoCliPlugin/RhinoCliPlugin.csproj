<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>RhinoCliPlugin</AssemblyName>
    <RootNamespace>RhinoCliPlugin</RootNamespace>
    <TargetExt>.rhp</TargetExt>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AssemblyTitle>RhinoCliPlugin</AssemblyTitle>
    <AssemblyDescription>Core Rhino plugin for rhino-cli automation handlers.</AssemblyDescription>
    <AssemblyVersion>0.1.0</AssemblyVersion>
    <FileVersion>0.1.0</FileVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <RhinoCommonHintPath Condition="'$(RhinoCommonHintPath)' == ''">C:\Program Files\Rhino 8\System\netcore\RhinoCommon.dll</RhinoCommonHintPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <RhinoCommonHintPath Condition="'$(RhinoCommonHintPath)' == ''">/Applications/Rhino 8.app/Contents/Frameworks/RhCore.framework/Versions/A/Resources/RhinoCommon.dll</RhinoCommonHintPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../server/RhinoCli.Server/RhinoCli.Server.csproj" />
    <Reference Include="RhinoCommon">
      <HintPath>$(RhinoCommonHintPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <MyDestinationFolder>$(APPDATA)\McNeel\Rhinoceros\myplugins\RhinoCliPlugin</MyDestinationFolder>
    <OldDestinationFolder>$(APPDATA)\McNeel\Rhinoceros\myplugins\MinimalPlugin</OldDestinationFolder>
  </PropertyGroup>

  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <MyDestinationFolder>$(HOME)/Library/Application Support/McNeel/Rhinoceros/8.0/MacPlugins/RhinoCliPlugin</MyDestinationFolder>
    <OldDestinationFolder>$(HOME)/Library/Application Support/McNeel/Rhinoceros/8.0/MacPlugins/MinimalPlugin</OldDestinationFolder>
  </PropertyGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <ItemGroup>
      <PluginFiles Include="$(TargetDir)*.*" />
    </ItemGroup>
    <RemoveDir Directories="$(OldDestinationFolder)" Condition="Exists('$(OldDestinationFolder)')" />
    <MakeDir Directories="$(MyDestinationFolder)" />
    <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(MyDestinationFolder)" />
    <Message Text="RhinoCliPlugin installed to $(MyDestinationFolder)" Importance="high" />
  </Target>
</Project>
